# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Test, lint, and notebook caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Python package build artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Local training and experiment outputs
runs/
outputs/
wandb/
lightning_logs/
tensorboard/
mlruns/
logs/

# Temporary files and logs
*.log
*.tmp
*.swp
*.swo

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
